{
  "name": "@mba/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration",

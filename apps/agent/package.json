    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "viem": "2.57.13",
    "zod": "4.6.7",
    "@mba/zktls": "workspace:*",
    "@reclaimprotocol/zk-fetch": "1.1.0",
    "@mba/circuits": "workspace:*",
    "@mba/zkverify": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0"

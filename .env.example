# Copy to .env and fill in. Never commit .env.
# The agent (apps/agent) and Foundry scripts read this file.

# --- EVM testnet: Ethereum Sepolia (Phase 1+) ---
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Testnet-only deployer key. Fund its address with Sepolia ETH; never reuse a mainnet key.
DEPLOYER_PRIVATE_KEY=0xplaceholder

# --- Agent service ---
PORT=8787
DATABASE_PATH=./data/mandate-bounty.sqlite
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111
# From packages/contracts/deployments/11155111.json after deploying
VAULT_ADDRESS=0xplaceholder
VAULT_DEPLOY_BLOCK=0
SYNC_INTERVAL_MS=10000
CORS_ORIGINS=http://localhost:3000

# --- Agent Games endpoint (dashboard "Rotate Secret"; shown once) ---
AGENT_GAMES_HMAC_SECRET=placeholder

# --- Claude (Phase 3) ---
ANTHROPIC_API_KEY=sk-ant-placeholder

# --- GitHub (Phases 2 and 4) ---
GITHUB_TOKEN=ghp_placeholder
GITHUB_WEBHOOK_SECRET=placeholder

# --- Reclaim zkFetch (Phase 4) ---
RECLAIM_APP_ID=0xplaceholder
RECLAIM_APP_SECRET=0xplaceholder

# --- zkVerify via Kurier, testnet (Phase 6) ---
KURIER_API_URL=https://api-testnet.kurier.xyz/api/v1
KURIER_API_KEY=placeholder
# zkVerify aggregation proxy on Ethereum Sepolia (docs: architecture/contract-addresses)
ZKVERIFY_AGGREGATION_ADDRESS=0xEA0A0f1EfB1088F4ff0Def03741Cb2C64F89361E

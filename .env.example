# Copy to .env and fill in. Never commit .env.
# The agent (apps/agent) and Foundry scripts read this file.

# --- EVM testnet: Ethereum Sepolia (Phase 1+) ---
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Testnet-only deployer key. Fund its address with Sepolia ETH; never reuse a mainnet key.
DEPLOYER_PRIVATE_KEY=0xplaceholder

# --- Agent service ---
PORT=8787
DATABASE_PATH=./data/mandate-bounty.sqlite
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111
# From packages/contracts/deployments/11155111.json after deploying
VAULT_ADDRESS=0xplaceholder
VAULT_DEPLOY_BLOCK=0
SYNC_INTERVAL_MS=10000
CORS_ORIGINS=http://localhost:3000

# --- Agent Games endpoint (dashboard "Rotate Secret"; shown once) ---
AGENT_GAMES_HMAC_SECRET=placeholder

# --- Advisory review LLM (Phase 2). Set one key; REVIEW_PROVIDER forces a choice (claude or gemini). ---
ANTHROPIC_API_KEY=sk-ant-placeholder
GEMINI_API_KEY=placeholder
# GEMINI_MODEL=gemini-3.5-flash
# REVIEW_PROVIDER=gemini

# --- GitHub (Phases 2 and 4) ---
GITHUB_TOKEN=ghp_placeholder
# Local dev: read the token from the GitHub CLI at startup instead of storing it here.
# GITHUB_TOKEN_COMMAND=gh auth token
GITHUB_POLL_INTERVAL_MS=60000
GITHUB_WEBHOOK_SECRET=placeholder

# --- Reclaim zkFetch (Phase 3; dev.reclaimprotocol.org) ---
RECLAIM_APP_ID=0xplaceholder
RECLAIM_APP_SECRET=0xplaceholder
# Optional: comma-separated trusted attestor addresses (default: Reclaim's published list)
# RECLAIM_ATTESTORS=

# --- zkVerify via Kurier, testnet (Phase 6) ---
KURIER_API_URL=https://api-testnet.kurier.xyz/api/v1
KURIER_API_KEY=placeholder
# zkVerify aggregation proxy on Ethereum Sepolia (docs: architecture/contract-addresses)
ZKVERIFY_AGGREGATION_ADDRESS=0xEA0A0f1EfB1088F4ff0Def03741Cb2C64F89361E
# Wait for aggregation on Sepolia and have the vault check it on-chain (true), or accept direct verification (false)
ZKVERIFY_AGGREGATION_REQUIRED=true
ZKVERIFY_DOMAIN_ID=0
# Registered verification key hash (from Kurier register-vk); the deploy script sets it on the vault
ZKVERIFY_VK_HASH=0xplaceholder

# --- Payout signer (the vault's agent) ---
# Dedicated testnet key, never the deployer's. Its address goes in AGENT_ADDRESS for the deploy script.
AGENT_PRIVATE_KEY=0xplaceholder
AGENT_ADDRESS=0xplaceholder

# --- Demo video voiceover (optional): Sarvam AI text-to-speech, dashboard.sarvam.ai ---
SARVAM_API_KEY=placeholder
# SARVAM_MODEL=bulbul:v3
# SARVAM_SPEAKER=shubh
